# Copy this file to .env and fill in ONE key. Never commit .env.

# Option 1: Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Option 2: Gemini, has a free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the model (defaults: claude-haiku-5-5 or gemini-3.6-flash)
# AI_MODEL=
# Optional: if both keys are set, choose one: anthropic or gemini
# AI_PROVIDER=
